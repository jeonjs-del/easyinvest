# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채워 넣으세요.
# secrets.toml은 .gitignore에 등록되어 있어 저장소에 커밋되지 않습니다.

# 은퇴 탭 실거래가 자동 조회용 — 공공데이터포털 "국토교통부 아파트 매매 실거래가 자료" 인증키.
# 비워 두면 실거래가 조회만 꺼지고 나머지는 동작합니다. [gist] 같은 표 위(최상단)에 둬야 합니다.
MOLIT_SERVICE_KEY = ""

[gist]
token = ""
id = ""

# 은퇴 탭 잠금 비밀번호. 비워 두면 앱 주소를 아는 누구나 자산 정보를 보고 수정할 수 있습니다.
[wealth]
password = ""

# 은퇴 탭 금융자산을 Google 스프레드시트에서 가져오기(선택). 넣은 종류만 시트 값으로 관리하고
# 나머지는 직접 입력으로 남습니다. 값은 스프레드시트 주소의 /d/ 와 /edit 사이 ID이며, 각 시트는
# "링크가 있는 모든 사용자: 뷰어"로 공유돼 있어야 합니다 — ID를 아는 사람은 누구나 볼 수 있으니
# 이 ID를 저장소·문서에 적지 마세요.
[wealth_sheets]
pension = ""   # 개인연금·퇴직연금 (최신 "YY-MM" 시트)
stock = ""     # 주식 (최신 "YY-MM" 시트)
crypto = ""    # 암호화폐 (최신 "YY-전략" 시트)
debt = ""      # 금융 부채 (최신 "YYYY" 시트의 D9)
