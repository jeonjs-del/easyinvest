# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채워 넣으세요.
# secrets.toml은 .gitignore에 등록되어 있어 저장소에 커밋되지 않습니다.

# 은퇴 탭 실거래가 자동 조회용 — 공공데이터포털 "국토교통부 아파트 매매 실거래가 자료" 인증키.
# 비워 두면 실거래가 조회만 꺼지고 나머지는 동작합니다. [gist] 같은 표 위(최상단)에 둬야 합니다.
MOLIT_SERVICE_KEY = ""

[gist]
token = ""
id = ""

# 은퇴 탭 잠금 비밀번호. 비워 두면 앱 주소를 아는 누구나 자산 정보를 보고 수정할 수 있습니다.
[wealth]
password = ""
